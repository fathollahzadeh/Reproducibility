# Generate Matrix

out=$out
s=$s

A = rand(rows=s, cols=0.1*s, min=0, max=65536)
B = rand(rows=0.1*s, cols=s, min=0, max=65536)
C = rand(rows=s, cols=0.1*s, min=0, max=65536)
D = rand(rows=0.1*s, cols=10*s, min=0, max=65536)
E = rand(rows=10*s, cols=s, min=0, max=65536)


# Write matrix to file
write(A, out+"/A_matrix.csv", format="csv", singlefile="true")
write(B, out+"/B_matrix.csv", format="csv", singlefile="true")
write(C, out+"/C_matrix.csv", format="csv", singlefile="true")
write(D, out+"/D_matrix.csv", format="csv", singlefile="true")
write(E, out+"/E_matrix.csv", format="csv", singlefile="true")
