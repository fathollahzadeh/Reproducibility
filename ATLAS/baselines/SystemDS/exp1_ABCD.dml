# Generate Matrix

out=$out

A = read($matrix_path+"/A_matrix.csv", data_type="matrix");
B = read($matrix_path+"/B_matrix.csv", data_type="matrix");
C = read($matrix_path+"/C_matrix.csv", data_type="matrix");
D = read($matrix_path+"/D_matrix.csv", data_type="matrix");

Y = A %*% B %*% C %*% D

write(Y, out+"/Y.csv", format="csv")